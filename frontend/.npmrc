# Dependency resolution is strict.
#
# `legacy-peer-deps=true` used to live here so ngx-bootstrap — which never
# supported Angular 21 — could be installed anyway. That package has been
# removed and nothing else in the tree needs the escape hatch; leaving it on
# would hide the next genuine peer-dependency conflict.
#
# `audit-level=critical` also used to live here, which silently lowered the bar
# for every `npm audit` anyone ran locally. The thresholds now live where they
# are visible: the `audit:prod` script and the CI workflow.
engine-strict=true
