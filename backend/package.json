{
  "name": "nyelvszo-backend",
  "version": "2.2.0",
  "description": "NyelvSzó - English-Hungarian Linguistic Dictionary API",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "dev": "nodemon ./src/index.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "test:integration": "jest --testPathPatterns=integration --detectOpenHandles --forceExit",
    "test:unit": "jest --testPathPatterns=unit --detectOpenHandles --forceExit",
    "test:ci": "jest --ci --coverage --detectOpenHandles --forceExit --maxWorkers=2",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"{src,tests}/**/*.js\"",
    "format:check": "prettier --check \"{src,tests}/**/*.js\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "seed": "node ./src/seed/seeder.js",
    "health": "curl -s http://localhost:3000/health | jq"
  },
  "author": "Adam Dr. Porkolab & Tamás Dr. Fekete",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "config": "^4.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.1",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.11",
    "morgan": "^1.10.1",
    "node-cache": "^5.1.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@eslint/js": "^9.39.1",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  }
}
