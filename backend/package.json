{
  "name": "nyelvszo-backend",
  "version": "2.5.0",
  "description": "NyelvSz\u00f3 - English-Hungarian Linguistic Dictionary API",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "dev": "nodemon ./src/index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch --detectOpenHandles",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --detectOpenHandles --forceExit",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPatterns=integration --detectOpenHandles --forceExit",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPatterns=unit --detectOpenHandles --forceExit",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --ci --coverage --detectOpenHandles --forceExit --maxWorkers=2",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"{src,tests}/**/*.js\"",
    "format:check": "prettier --check \"{src,tests}/**/*.js\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "seed": "node ./src/seed/seeder.js",
    "health": "curl -s http://localhost:3000/health | jq"
  },
  "author": "Adam Dr. Porkolab & Tam\u00e1s Dr. Fekete",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "config": "^5.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "joi": "^18.2.8",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "morgan": "^1.12.0",
    "node-cache": "^5.1.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jest-environment-node": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
