# ---------------------------------------------------------------------------
# NyelvSzó API — environment
#
# Copy to .env and fill in. The server validates this file at boot and refuses
# to start with an actionable message rather than failing on the first request.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Either set MONGODB_URI outright (preferred), or provide the DB_* parts below
# and let the server assemble the URI.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/nyelvszo?retryWrites=true&w=majority

DB_HOST=localhost:27017
DB_USER=
DB_PASS=
DB_NAME=nyelvszo

DB_MAX_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000
DB_SOCKET_TIMEOUT_MS=45000

# --- JWT -------------------------------------------------------------------
# Two DIFFERENT secrets, each at least 32 characters. Reusing one secret for
# both lets any access token renew itself forever. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Short-lived access token, long-lived refresh token.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- CORS ------------------------------------------------------------------
# Comma-separated exact origins. Required in production.
ALLOWED_ORIGINS=http://localhost:4200,https://nyelvszo.eu

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# --- Proxy -----------------------------------------------------------------
# Number of reverse proxies in front of this service. Leave at 0 when the app
# is exposed directly. Never set this higher than the real hop count: each
# extra hop lets a client forge one more X-Forwarded-For entry and evade rate
# limiting.
TRUST_PROXY_HOPS=0

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Security headers ------------------------------------------------------
HELMET_ENABLED=true

# --- Seeding (npm run seed) ------------------------------------------------
# The initial administrator. Leave unset to seed only the dictionary entries.
# These are read at seed time and never stored in the repository — a seed file
# with a fixed administrator password used to be committed here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
