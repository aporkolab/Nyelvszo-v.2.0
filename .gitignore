# Environment
#
# Deny every dotenv variant and re-allow only the committed template. The
# previous list named .env.production.local but not .env.production or
# .env.prod, so the one file that holds real production credentials was the one
# nothing stopped from being committed.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Framework outputs
.next
out
.nuxt
dist
.angular/
.vuepress/dist
.temp
.docusaurus

# Serverless
.serverless/

# Database
.dynamodb/

# Editor
.tern-port
.vscode-test
.history/
*.vsix

# VSCode (keep some config)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Runtime state produced by the Docker stacks: TLS material and issued
# certificates must never reach the repository.
nginx/ssl/
nginx/logs/
certbot/
backend/logs/

# Stray root lockfile: this repo has no root package.json — the two
# workspaces (backend/, frontend/) own their own. An accidental `npm install`
# from the repo root recreates one, which then confuses tooling.
/package-lock.json
